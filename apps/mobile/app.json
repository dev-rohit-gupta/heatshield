{
  "expo": {
    "name": "HeatShield",
    "slug": "heatshield",
    "scheme": "heatshield",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationWhenInUsePermission": "HeatShield uses location to show local weather while you use the app."
        }
      ]
    ],
    "android": {
      "package": "com.example.heatshield",
      "edgeToEdgeEnabled": true
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "not-configured"
    }
  }
}
